    1  cd /
    2  ls
    3  cd home/
    4  ls
    5  cd dev/
    6  ls
    7  cd ../ubuntu/
    8  ls
    9  cd ../dev/
   10  ls -al
   11  mkdir -p ~/.ssh && chmod 700 ~/.ssh
   12  ls -al
   13  ls
   14  ls -a
   15  cat > ~/.ssh/config <<'EOF'
Host jump
    HostName jump
    User dev
    ForwardAgent yes

EOF

   16  chmod 600 ~/.ssh/config
   17  ls -al
   18  ls -la .ssh/ 
   19  ssh-keygen -h
   20  man ssh-keygen
   21  ssh-keygen
   22  cd .ssh/
   23  ls
   24  export -p
   25  eval "$(ssh-agent -s)"
   26  ps 
   27  ps -aux
   28  ssh-add -l
   29  ssh-add ~/.ssh/id_ed25519
   30  ssh-add -l
   31  export -p
   32  history
   33  ls
   34  cat ~/.ssh/id_ed25519.pub
   35  history
