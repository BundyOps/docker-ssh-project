    1  apt-get update
    2  apt-get install -y openssh-server
    3  useradd -m -s /bin/bash dev
    4  mkdir -p /home/dev/.ssh
    5  chown dev:dev /home/dev/.ssh
    6  chmod 700 /home/dev/.ssh
    7  cd /home/dev/.ssh
    8  ls
    9  echo "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAICdAzEAtfZJMdyQVq5JWW1GQ+fjd4sZnPY+IQxn/lFoV dev@17ad01b055f7" >> /home/dev/.ssh/authorized_keys
   10  ls
   11  cat authorized_keys 
   12  chown dev:dev /home/dev/.ssh/authorized_keys
   13  chmod 600 /home/dev/.ssh/authorized_keys
   14  cd /etc/ssh
   15  ls
   16  cat sshd_config
   17  history
   18  cat >> /etc/ssh/sshd_config <<'EOF'

AllowAgentForwarding yes
PubkeyAuthentication yes
PermitRootLogin no
EOF

   19  ss -tlnp | grep 22
   20  ss -tlnp
   21  mkdir -p /run/sshd
   22  cd /run
   23  ls
   24  cd sshd/
   25  ls
   26  cd /usr/sbin/sshd
   27  cat /usr/sbin/sshd
   28  ss -tlnp | grep 22
   29  cd /usr/sbin
   30  ls
   31  /usr/sbin/sshd
   32  ps -aux
   33  ss -tlnp
   34  history

